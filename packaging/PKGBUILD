# Maintainer: Douglas Moura <doug@douglasmoura.com>
pkgname=metronome
pkgver=0.1.0
pkgrel=1
pkgdesc="A metronome for Omarchy: Rust backend, Quickshell/QML frontend, follows the Omarchy theme"
arch=(x86_64 aarch64)
url="https://github.com/douglasdemoura/metronome"
license=(MIT)
depends=(quickshell alsa-lib)
makedepends=(cargo)
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=("SKIP")

build() {
  cd "$pkgname-$pkgver"
  cargo build --release --locked
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 target/release/metronome "$pkgdir/usr/bin/metronome"
  install -d "$pkgdir/usr/share/metronome"
  cp -r ui "$pkgdir/usr/share/metronome/ui"
  install -Dm644 packaging/metronome.desktop "$pkgdir/usr/share/applications/metronome.desktop"
  install -Dm644 packaging/metronome.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/metronome.svg"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
