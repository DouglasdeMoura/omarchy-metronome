<component type="desktop-application">
  <id>dev.douglasmoura.metronome</id>
  <metadata_license>MIT</metadata_license>
  <project_license>MIT</project_license>
  <name>Metronome</name>
  <summary>Keep time with a metronome that follows your Omarchy theme</summary>
  <description>
    <p>
      A metronome for Omarchy with sample-accurate clicks, a time signature
      editor, per-beat accents, tap tempo and subdivisions shown in musical
      notation, from eighths and triplets to dotted rhythms and sextuplets.
    </p>
    <p>
      Its colours, type and spacing follow the live Omarchy theme, it is
      fully usable from the keyboard, and it is ready for translation.
    </p>
  </description>
  <launchable type="desktop-id">dev.douglasmoura.metronome.desktop</launchable>
  <provides>
    <binary>omarchy-metronome</binary>
  </provides>
  <url type="homepage">https://github.com/DouglasdeMoura/omarchy-metronome</url>
